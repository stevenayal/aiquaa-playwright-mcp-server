# Backend AIQUAA
AIQUAA_API_BASE_URL=https://api.example.aiquaa.com
AIQUAA_ACCESS_TOKEN=your-supabase-jwt-for-local-development
# Deadline por request; sin esto un backend colgado cuelga la tool call.
AIQUAA_TIMEOUT_MS=15000
# Reintentos ante 429 y 5xx, con backoff y respeto de Retry-After.
AIQUAA_MAX_RETRIES=2
# Techos del paginado de reglas: al superarlos la respuesta avisa que truncó.
AIQUAA_MAX_RULES=500
AIQUAA_MAX_PAGES=10
AIQUAA_CACHE_TTL_MS=60000

# Transporte
# stdio para clientes locales (o pasá --stdio); vacío o http para Streamable HTTP.
MCP_TRANSPORT=http
PORT=3000
MCP_PATH=/mcp
# Bind local por defecto: el endpoint MCP no tiene autenticación propia.
MCP_HOST=127.0.0.1
# Necesarios solo detrás de un proxy o con un hostname público.
# MCP_ALLOWED_HOSTS=mcp.interno.example.com,mcp.interno.example.com:3000
# MCP_ALLOWED_ORIGINS=https://app.example.com

# Integraciones locales
CODEGRAPH_BIN=codegraph
CODEGRAPH_ALLOWED_ROOTS=/workspace/projects
ENGRAM_BIN=engram
ENGRAM_PROJECT_PREFIX=aiquaa-
